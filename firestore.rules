rules_version = '2';

// قواعد أمان Cloud Firestore لتطبيق Dhakker.
// المبدأ: لا أحد يقرأ أو يكتب إلا ما يخصّه. الأدمن (role == 'admin' في users)
// يدير المحتوى، والحاج يقرأ المحتوى ويحدّث وثيقته فقط.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // الأدمن يُحدَّد من حقل role في وثيقة المستخدم نفسه.
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // users: المستخدم يقرأ/يحدّث وثيقته فقط؛ الأدمن يقرأ الجميع (للإحصائيات).
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // التسجيل: ينشئ المستخدم وثيقته بنفسه بدور pilgrim فقط (لا يمنح نفسه admin).
      allow create: if isOwner(userId)
                    && request.resource.data.role == 'pilgrim';

      // التحديث: الحاج يحدّث وثيقته دون تغيير دوره؛ الأدمن صلاحية كاملة.
      allow update: if isAdmin()
                    || (isOwner(userId)
                        && request.resource.data.role == resource.data.role);

      allow delete: if isAdmin();
    }

    // zones: قراءة لأي مستخدم مسجّل؛ الكتابة للأدمن فقط.
    match /zones/{zoneId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── حقول التوثيق (provenance) للمصادر ────────────────────────────────
    // سجلّات supplications هي سجلّات محتوى قائمة، وليست مصادر معتمدة بحد
    // ذاتها. لا يُعتبر أي سجلّ موثّقاً إلا بعد مطابقته يدوياً بمصدر رسمي
    // منشور وتسجيل ذلك في هذه الحقول.
    function verificationKeys() {
      return [
        'verificationStatus', 'authority', 'sourceUrl', 'sourceVersion',
        'sourceLanguage', 'sourceSection', 'verifiedAt', 'verifiedBy',
        'contentHash', 'revokedAt', 'reviewNotes'
      ];
    }

    function touchesVerificationFields() {
      return request.resource.data.diff(resource.data)
               .affectedKeys().hasAny(verificationKeys());
    }

    // سجلّ "موثّق" غير مكتمل = مرفوض. تُطبَّق نفس الشروط التي يفرضها
    // الوسيط (worker.js) حتى لا يعتمد الأمان على تحقّق العميل وحده.
    // ملاحظة: نتحقق من وجود الحقل بـ `in` قبل قراءته. قراءة حقل غير موجود
    // في قواعد Firestore تُنتج خطأ تقييم (يمنع الوصول لكنه غير نظيف)، لذا
    // نجعل الرفض صريحاً ومقروءاً في السجلّات.
    function hasCompleteProvenance(data) {
      return data.verificationStatus == 'verified'
        && ('authority' in data)
        && data.authority is string && data.authority.size() > 0
        && ('sourceUrl' in data)
        && data.sourceUrl is string && data.sourceUrl.matches('https://.+')
        && ('sourceVersion' in data)
        && data.sourceVersion is string && data.sourceVersion.size() > 0
        && ('sourceLanguage' in data)
        && data.sourceLanguage is string && data.sourceLanguage.size() > 0
        && ('verifiedBy' in data)
        && data.verifiedBy is string && data.verifiedBy.size() > 0
        && ('verifiedAt' in data) && data.verifiedAt != null
        && (!('revokedAt' in data) || data.revokedAt == null);
    }

    // يُسمح بالكتابة إذا لم يُدَّعَ التوثيق، أو ادُّعي مع استيفاء كل الحقول.
    function verificationClaimIsValid() {
      return !('verificationStatus' in request.resource.data)
        || request.resource.data.verificationStatus != 'verified'
        || hasCompleteProvenance(request.resource.data);
    }

    // supplications: قراءة لأي مسجّل؛ الأدمن يكتب؛ الحاج يحدّث usage_count فقط.
    // لا يستطيع الحاج بأي حال لمس حقول التوثيق (لا إنشاءً ولا تعديلاً).
    // ما يجوز أن يراه الحاج: موثَّق، فعّال، غير ملغى. ثلاثة شروط فقط.
    //
    // لا تُضاف هنا شروط الإثبات (authority/sourceUrl/…): بوابة الكتابة
    // `hasCompleteProvenance` تمنع أصلًا وسم أي سجل verified بلا إثبات
    // كامل، فتكرارها هنا يثقل كل قراءة بشروط لا يمكن للاستعلام إثباتها،
    // ولا يضيف أمانًا.
    //
    // `revokedAt` يُقارَن مساواةً صريحة، لا بشرط تفريعي يقبل الغياب.
    //
    // السبب عملي لا جمالي: محرّك القواعد يتعامل مع `get` و`list` تعاملين
    // مختلفين. صيغة `!('revokedAt' in data) || data.revokedAt == null`
    // تمنع الجلب المباشر لسجل ملغى، لكنها في `list` لا تُترجَم إلى قيد
    // يمكن التحقق منه، فيمرّ السجل الملغى داخل نتيجة استعلام غير مقيَّد.
    // ثبت ذلك تجريبيًّا: استعلام بـisActive+verified أعاد سجلًا ملغى رغم
    // أن الجلب المباشر له كان مرفوضًا.
    //
    // المساواة الصريحة قابلة للترجمة، فتُفرض في المسارين معًا. ثمنها أن
    // سجلًا لا يحمل الحقل أصلًا يصير غير مقروء — وهو فشل مغلق مقصود:
    // المستورد يكتب `revokedAt: null` دائمًا، ولوحة الإضافة كذلك.
    function isPubliclyReadable(data) {
      return data.isActive == true
        && data.verificationStatus == 'verified'
        && data.revokedAt == null;
    }

    match /supplications/{duaId} {
      // get و list مفصولان عمدًا.
      //
      // `get`: يُقيَّم الشرط على المستند المطلوب نفسه، فلا يستطيع مستخدم
      // عادي جلب سجل غير موثّق بمعرفته المباشر — وهي الثغرة التي كان
      // `if isSignedIn()` يتركها مفتوحة مهما رشّح التطبيق استعلاماته.
      //
      // `list`: تُقيَّم القواعد على كل مستند يطابق الاستعلام، ويُرفض
      // الاستعلام كاملًا إن طابق مستندًا واحدًا لا يجتاز الشرط. فالقواعد
      // ليست مرشِّحًا: على الاستعلام أن يحمل القيود الثلاثة بنفسه، وإلا
      // فشل بـ permission-denied. هذا مقصود — الفشل الصريح أفضل من تسريب
      // صامت.
      allow get: if isAdmin() || (isSignedIn() && isPubliclyReadable(resource.data));
      allow list: if isAdmin() || (isSignedIn() && isPubliclyReadable(resource.data));

      allow delete: if isAdmin();

      allow create: if isAdmin()
        && (!('verificationStatus' in request.resource.data)
            || request.resource.data.verificationStatus != 'verified'
            || hasCompleteProvenance(request.resource.data));

      allow update: if (isAdmin() && verificationClaimIsValid())
        || (isSignedIn()
            && request.resource.data.diff(resource.data)
                  .affectedKeys().hasOnly(['usage_count'])
            && !touchesVerificationFields());
    }

    // ── supplications_staging ────────────────────────────────────────────
    //
    // Import trials write here (see .github/workflows/staging-import.yml).
    // No client ever reads it: the app queries `supplications`, and the
    // staging collection holds unreviewed records that must never reach a
    // pilgrim.
    //
    // WHAT THIS BLOCK IS, AND WHAT IT IS NOT.
    //
    // It is documentation and present-day defence: it states the intent at
    // the collection where a reader looks for it, rather than leaving the
    // denial implicit in the catch-all at the bottom.
    //
    // It is NOT an override. Firestore evaluates matching rules with OR
    // semantics: a request is allowed if ANY matching allow expression is
    // true. `if false` here denies nothing that another rule permits — add a
    // broader `match` with a true `allow` later and access is granted
    // regardless of this block. There is no rule precedence to rely on.
    //
    // So the real regression guard is behavioural, not textual: the tests in
    // test_firestore_rules/rules.test.mjs exercise the COMPLETE ruleset
    // against the emulator and fail if any future rule makes this collection
    // reachable — for unauthenticated users, ordinary users, or admins.
    match /supplications_staging/{document=**} {
      allow read, write: if false;
    }

    // ── supplications_legacy_archive ─────────────────────────────────────
    //
    // Full copies of documents retired from `supplications`
    // (see .github/workflows/legacy-retirement.yml). It exists so a deletion
    // is reversible: the archive holds every field of every retired
    // document, including its audioUrl, so a record can be reconstructed.
    //
    // No client may read it, and the admin least of all. Its contents are
    // exactly what was judged unfit to show a pilgrim — unverified, with no
    // contentKind and no provenance — so a screen that listed it would put
    // that text back in front of the people the retirement removed it from.
    // The archive is reached with a service-account credential, by hand,
    // through the retirement workflow. Never from the app.
    //
    // The same caveat as the staging block applies: Firestore evaluates
    // matching rules with OR semantics, so `if false` denies nothing that a
    // future broader rule permits. The real guard is the emulator tests,
    // which exercise the complete ruleset.
    match /supplications_legacy_archive/{document=**} {
      allow read, write: if false;
    }

    // alerts: تنبيهات الإدارة للحجّاج. قراءة لأي مسجّل، كتابة/حذف للأدمن فقط.
    match /alerts/{alertId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // config: إعدادات عامة (مثل رقم طوارئ SOS). قراءة لأي مسجّل، كتابة للأدمن.
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // sos_requests: الحاج ينشئ نداء استغاثته باسمه؛ الأدمن يقرأ ويحدّث الحالة.
    match /sos_requests/{reqId} {
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // ── مجموعات الحجّاج العائلية ─────────────────────────────────────────
    //
    // هذه المجموعات تحمل أخطر بيانات في التطبيق: إحداثيات GPS اللحظية
    // لأفراد العائلة، بينهم نساء وأطفال وكبار سن.
    //
    // الصياغة السابقة كانت تسرّبها لأي مستخدم مسجّل، عبر ثلاث خطوات أثبتها
    // الاختبار على المحاكي:
    //   1) `allow read: if isSignedIn()` على وثيقة المجموعة كان يسمح بسرد
    //      كل المجموعات وقراءة كود الانضمام من كل واحدة.
    //   2) `allow create ... if memberId == request.auth.uid` كان يسمح لأي
    //      مسجّل بإقحام نفسه عضوًا في أي مجموعة، بلا كود أصلًا.
    //   3) وشرط القراءة `exists(members/$(uid))` يصير محقَّقًا بالوثيقة التي
    //      أنشأها للتوّ — فيقرأ مواقع العائلة كلها.
    // أي حساب حاج واحد كان يكفي لتتبّع كل مستخدمي التطبيق.
    //
    // الإغلاق هنا يقوم على مبدأين:
    //   • الكود سرّ يُثبَت، لا يُكتشف: لا سرد لوثائق المجموعات إطلاقًا،
    //     والانضمام يشترط تقديم الكود ومطابقته خادميًّا بوثيقة المجموعة.
    //   • من لا يملك عضوية قائمة لا يقرأ شيئًا: القراءة للأعضاء والمالك.
    //
    // الضمان سلوكي لا نصّي: اختبارات المحاكي في
    // test_firestore_rules/rules.test.mjs تعيد تمثيل الهجوم الثلاثي أعلاه
    // كاملًا وتفشل إن عاد أي جزء منه ممكنًا.

    function isGroupMember(groupId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    // group_codes/{code}: مؤشّر كود → معرّف مجموعة، معرّفه هو الكود نفسه.
    //
    // وجوده هو ما يسمح بإلغاء `list` على `groups` كليًّا: تحويل الكود إلى
    // معرّف مجموعة صار `get` مباشرًا على وثيقة اسمها الكود، فلا يصل إليها
    // إلا من يعرف الكود سلفًا. السرد ممنوع، فلا تُعدّ الأكواد ولا تُجمع.
    //
    // لا تعديل ولا حذف بعد الإنشاء: كود مُسجَّل لا يُعاد توجيهه إلى مجموعة
    // أخرى. لو سُمح بالتعديل لأمكن لمهاجم أن يخطف كودًا شائعًا فيوجّه من
    // ينضم به إلى مجموعته هو.
    match /group_codes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
                    && request.resource.data.groupId is string
                    && request.resource.data.groupId.size() > 0
                    && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if false;
    }

    match /groups/{groupId} {
      // لا سرد. سرد المجموعات هو ما كان يسرّب الأكواد.
      allow list: if false;
      allow get: if isGroupMember(groupId)
                 || (isSignedIn() && resource.data.ownerId == request.auth.uid);

      allow create: if isSignedIn()
                    && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn()
                    && resource.data.ownerId == request.auth.uid;

      // أفراد المجموعة (تحوي المواقع): يقرؤها الأعضاء فقط.
      //
      // الانضمام (create) يشترط إثبات معرفة الكود: تُكتب `joinCode` في
      // الوثيقة، وتُقارَن خادميًّا بكود المجموعة. العميل لا يُصدَّق.
      //
      // التعديل والحذف على وثيقة العضو نفسه فقط، وبلا شرط الكود: تحديث
      // الموقع (set/merge على وثيقة قائمة) والمغادرة عمليتان لعضو أثبت
      // انتماءه لحظة انضمامه. ولا يمكن الالتفاف بـ`update` لإنشاء عضوية:
      // التحديث يفشل على وثيقة غير موجودة، و`set` عليها يُقيَّم كإنشاء.
      match /members/{memberId} {
        allow read: if isGroupMember(groupId);

        allow create: if isSignedIn()
          && memberId == request.auth.uid
          && request.resource.data.joinCode
             == get(/databases/$(database)/documents/groups/$(groupId)).data.code;

        allow update, delete: if isSignedIn()
          && memberId == request.auth.uid;
      }
    }

    // broadcasts: إشعارات جماعية من الأدمن. الحجاج يقرأون فقط، الأدمن ينشئ/يحذف.
    match /broadcasts/{msgId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      // لا update — الرسالة تُرسَل مرة واحدة ولا تُعدَّل
    }

    // knowledge_documents / knowledge_chunks: سجلّ المصادر المعتمدة للمساعد
    // الذكي (RAG). القراءة لأي مستخدم مسجّل فقط (الوسيط Cloudflare يستدعيها
    // بتوكن هوية المستخدم نفسه)، والكتابة للأدمن فقط — لا يمكن لأي مستخدم أن
    // "يوثّق" محتوى نفسه أو يزرع مصدراً غير معتمد.
    match /knowledge_documents/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /knowledge_chunks/{chunkId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // assistant_feedback: تقييم اختياري (مفيد/غير مفيد) لردود المساعد.
    // لا نص محادثة كامل يُحفظ افتراضياً — فقط عند includesMessageText==true
    // بموافقة المستخدم الصريحة على نفس الوثيقة وقت الإنشاء. كل حاج يكتب
    // تقييمه فقط ولا يقرأ/يعدّل تقييمات غيره؛ الأدمن يقرأ للتجميع فقط.
    match /assistant_feedback/{feedbackId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && (
          request.resource.data.includesMessageText != true
          || request.resource.data.consentToStoreText == true
        );
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // الافتراضي: منع كل ما سوى ذلك صراحةً.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
