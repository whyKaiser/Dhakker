rules_version = '2';

// قواعد أمان Firebase Storage لملفات الأدعية الصوتية.
//
// القراءة: لأي مستخدم مسجّل (لتشغيل الصوت داخل التطبيق).
// الكتابة: للأدمن فقط، عبر custom claim، وداخل مسار الأدعية وحده.
//
// ── لماذا custom claim وليس دور Firestore ────────────────────────────────
//
// قواعد Storage لا تستطيع قراءة Firestore: لا يوجد فيها `get()` ولا
// `exists()`. فدالة `isAdmin()` المستعملة في firestore.rules — والتي تقرأ
// `users/{uid}.role == 'admin'` — لا يمكن تكرارها هنا بأي صياغة. المصدر
// الوحيد لهوية الأدمن المتاح لقواعد Storage هو ما يحمله التوكن نفسه، أي
// custom claim يضعه الخادم.
//
// ── فشل مغلق ─────────────────────────────────────────────────────────────
//
// `request.auth.token.admin == true` مساواة صريحة. المستخدم الذي لا يحمل
// الـclaim إطلاقاً تكون القيمة عنده غائبة، والمساواة تفشل — فيُرفض. لا
// يوجد فرع يسمح بالكتابة عند غياب الـclaim، ولا قيمة افتراضية تُعتبر
// صحيحة. النتيجة أن أي حساب لم يُمنح الـclaim صراحةً هو حساب لا يكتب.
//
// أثر تشغيلي مقصود: ما دام لا يوجد أي حساب يحمل الـclaim، فلا أحد يستطيع
// رفع صوت — بما في ذلك من يحمل `role == 'admin'` في Firestore. منح الـclaim
// خطوة يدوية موثّقة في docs/ADMIN_CLAIM_SETUP.md ولم تُنفَّذ بعد.
//
// ── ما الذي يحميه هذا فعلاً ──────────────────────────────────────────────
//
// قبل هذا التشديد كان أي مستخدم مسجّل — أي حاج — يستطيع الكتابة فوق
// `audio/duas/<id>.mp3` واستبدال صوت دعاء بأي صوت آخر. المسار في التطبيق
// مشتق من معرّف الوثيقة، ومعرّفات الأدعية مقروءة لكل مستخدم مسجّل، فكان
// الهدف معروفاً وقابلاً للاستبدال. مسار التوثيق كله في firestore.rules
// يمنع تزوير النص، وكانت هذه الثغرة تلتف حوله من جهة الصوت.
service firebase.storage {
  match /b/{bucket}/o {

    // الأدمن = من يحمل custom claim صريحاً. أي شيء آخر ليس أدمن.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.admin == true;
    }

    // ملفات الأدعية الصوتية فقط.
    //
    // القراءة بقيت كما كانت: أي مستخدم مسجّل، لأن التطبيق يشغّل الصوت
    // للحاج. لم تُضيَّق ولم تُوسَّع.
    //
    // الكتابة والحذف: للأدمن وحده. `write` في قواعد Storage تشمل الإنشاء
    // والاستبدال والحذف معاً، فالشرط الواحد يغطي الثلاثة — ولا يوجد
    // استبدال مسموح لغير الأدمن حتى لو كان الملف موجوداً أصلاً.
    //
    // حدود الحجم والنوع باقية فوق شرط الأدمن، لا بديلاً عنه: أدمن مخترَق
    // أو مخطئ لا يرفع 500MB ولا ملفاً تنفيذياً. الحذف يُستثنى من هذين
    // القيدين لأن `request.resource` غير موجود في طلب الحذف.
    match /audio/duas/{fileName} {
      allow read: if request.auth != null;

      allow write: if isAdmin()
        && request.resource != null
        && request.resource.size < 15 * 1024 * 1024          // أقل من 15MB
        && request.resource.contentType.matches('audio/.*'); // صوت فقط

      allow delete: if isAdmin();
    }

    // أي مسار آخر: القراءة للمسجّلين، والكتابة ممنوعة (لا رفع عشوائي).
    //
    // هذا يشمل `audio/duas/` نفسه كمجلد، وأي مسار أعمق مثل
    // `audio/duas/x/y.mp3` — المطابقة أعلاه على `{fileName}` قطعة واحدة
    // فقط، وما عداها يقع هنا ويُرفض.
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
